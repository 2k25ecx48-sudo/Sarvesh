/* =====================================================
PAYROLL
===================================================== */

function calculateSalary(
salary
){

salary =
Number(
salary || 0
);


const basic =
Math.round(
salary * .75
);


const allowance =
Math.round(
salary * .20
);


const deduction =
Math.round(
salary * .05
);


const net =
basic +
allowance -
deduction;


return{

basic,

allowance,

deduction,

net

};

}


/* =====================================================
PAYROLL UPDATE
===================================================== */

function updatePayroll(){

if(
currentUser.role==="employee"
){

const s =
calculateSalary(
currentUser.salary
);


document.getElementById(
"myBasic"
).innerText =
money(s.basic);


document.getElementById(
"myAllowance"
).innerText =
money(s.allowance);


document.getElementById(
"myDeduction"
).innerText =
money(s.deduction);


document.getElementById(
"myNet"
).innerText =
money(s.net);


return;

}


const employees =
users.filter(
u =>
u.role==="employee"
);


const tbody =
document.getElementById(
"hrPayrollTable"
);


if(
employees.length===0
){

tbody.innerHTML=`

<tr>

<td colspan="6">
No employees.
</td>

</tr>

`;

return;

}


tbody.innerHTML =
employees
.map(
e=>{

const s =
calculateSalary(
e.salary
);


return`

<tr>

<td>
${e.id}
</td>

<td>
${e.name}
</td>

<td>
${money(s.basic)}
</td>

<td>
${money(s.allowance)}
</td>

<td>
${money(s.deduction)}
</td>

<td>
<b>
${money(s.net)}
</b>
</td>

</tr>

`;

}
)
.join("");

}


/* =====================================================
HELPERS
===================================================== */

function money(
value
){

return "₹" +
Number(
value || 0
).toLocaleString(
"en-IN"
);

}


function getStatusClass(
status
){

if(
status==="Approved"
)
return "approved";


if(
status==="Rejected"
)
return "rejected";


return "pending";

}


/* =====================================================
LOGOUT
===================================================== */

function logout(){

sessionStorage.removeItem(
"dayflow_current"
);


currentUser =
null;


document.getElementById(
"app"
).style.display =
"none";


document.getElementById(
"loginPage"
).style.display =
"flex";


document.getElementById(
"loginForm"
).reset();

}

</script>

</body>
</html>
